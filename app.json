{
  "expo": {
    "name": "Reporte Ciudadano",
    "slug": "reporte-ciudadano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reporteciudadano",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.grupo53.reporteciudadano",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAUjgWHOynLlqypaToaS2RZ5NVN60JSbs0"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La aplicación necesita acceder a tu ubicación para mostrarte en el mapa."
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Reporte Ciudadano usa la cámara para sacar la foto del problema que reportás y para leer códigos QR en el mostrador."
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Reporte Ciudadano usa Face ID para que ingreses sin escribir la contraseña."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e36dfb51-e61c-4b3b-bde8-d75425d0aa53"
      }
    },
    "owner": "elisaexpos-team",
    "ios": {
      "bundleIdentifier": "com.grupo53.reporteciudadano",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
